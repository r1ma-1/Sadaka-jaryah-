let currentPeriod='morning';
const progress={morning:{},evening:{}};

function renderAzkar(){
 const list=document.getElementById('azkarList'); list.innerHTML='';
 azkar[currentPeriod].forEach((z,i)=>{
   const done=progress[currentPeriod][z.id]||0;
   const card=document.createElement('article'); card.className='zekr';
   card.innerHTML=`
    <div class="zekr-head"><div class="zekr-title">${i+1}. ${z.title}</div><div class="repeat">العدد: ${z.t}</div></div>
    <div class="zekr-text">${z.text}</div>
    <div class="benefit"> <b>الفضل باختصار:</b> ${z.benefit}</div>
    <div class="zekr-bottom">
      <div class="zekr-count">أتممت <b class="doneCount">${Math.min(done,z.t)}</b> من ${z.t}</div>
      <button class="zekr-btn ${done>=z.t?'done':''}">${done>=z.t?'تم بحمد الله':'سبّحت 1'}</button>
    </div>
    <div class="zekr-source">${z.source}</div>`;
   const btn=card.querySelector('.zekr-btn'), dc=card.querySelector('.doneCount');
   btn.addEventListener('click',async()=>{
     let n=(progress[currentPeriod][z.id]||0)+1;
     if(n>z.t){ n=0; showToast('أُعيد العداد لهذا الذكر'); }
     progress[currentPeriod][z.id]=n;
     dc.textContent=Math.min(n,z.t);
     btn.classList.toggle('done',n>=z.t);
     btn.textContent=n>=z.t?'تم بحمد الله':'سبّحت 1';
     await registerDhikr();
   });
   list.appendChild(card);
 });
}
document.getElementById('morningTab').onclick=()=>{currentPeriod='morning';morningTab.classList.add('active');eveningTab.classList.remove('active');renderAzkar()}
document.getElementById('eveningTab').onclick=()=>{currentPeriod='evening';eveningTab.classList.add('active');morningTab.classList.remove('active');renderAzkar()}
renderAzkar();

/* ---------- Tasbeeh ---------- */
const tasbeehPhrases=[
 'سبحان الله',
 'الحمد لله',
 'لا إله إلا الله',
 'الله أكبر',
 'لا حول ولا قوة إلا بالله',
 'أستغفر الله',
 'اللهم صل على سيدنا محمد'
];
const tasGrid=document.getElementById('tasGrid');
tasbeehPhrases.forEach((phrase,i)=>{
 const key='tas_'+i;
 const card=document.createElement('div');
 card.className='tas-card panel';
 card.innerHTML=`<div class="tas-name">${phrase}</div><div class="tas-num" id="tasNum${i}">0</div><button class="tas-ring" type="button" aria-label="التسبيح: ${phrase}"><span class="tas-center">اضغط للذكر</span></button><button class="reset" type="button">تصفير هذا العداد</button>`;
 const num=card.querySelector('.tas-num');
 const ring=card.querySelector('.tas-ring');
 const reset=card.querySelector('.reset');
 function load(){num.textContent=fmt(localStorage.getItem(key)||0)}
 ring.addEventListener('click',async()=>{
   const n=Number(localStorage.getItem(key)||0)+1;
   localStorage.setItem(key,String(n));
   num.textContent=fmt(n);
   await registerDhikr();
 });
 reset.addEventListener('click',()=>{localStorage.setItem(key,'0');load()});
 load();
 tasGrid.appendChild(card);
});

