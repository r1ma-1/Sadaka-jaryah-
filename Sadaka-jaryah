<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#6f4a2f">
<title>صدقة جارية | عبدالرحيم صبري عبدالرحيم حسنين</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;500;600;700&family=Scheherazade+New:wght@400;700&display=swap');

:root{
 --espresso:#352318;
 --brown:#5b3b26;
 --brown2:#765238;
 --beige:#efe3cf;
 --ivory:#fffaf1;
 --sand:#e3d2b4;
 --gold:#b8955d;
 --gold-light:#d9bd88;
 --muted:#7d6b59;
 --line:#dcc9a9;
 --shadow:0 18px 55px rgba(53,35,24,.10);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
 margin:0;color:var(--espresso);font-family:Cairo,Arial,sans-serif;
 background:#efe3cf;
}
button,select{font:inherit}
button{cursor:pointer}
a{text-decoration:none;color:inherit}
.container{width:min(1060px,calc(100% - 32px));margin:auto}

/* ================= HOME ================= */
.home{
 min-height:100svh;display:flex;align-items:center;justify-content:center;
 position:relative;overflow:hidden;color:#fff;
 background:
 linear-gradient(rgba(53,35,24,.91),rgba(91,59,38,.94)),
 radial-gradient(circle at 50% 30%,#a77c4b,transparent 40%);
}
.home::before{
 content:"";position:absolute;width:min(760px,95vw);height:min(760px,95vw);
 border:1px solid rgba(217,189,136,.25);border-radius:50%;
}
.home::after{
 content:"";position:absolute;width:min(570px,74vw);height:min(570px,74vw);
 border:1px solid rgba(217,189,136,.17);border-radius:50%;
}
.home-inner{position:relative;z-index:2;text-align:center;padding:45px 12px}
.bismillah{font:400 25px Amiri,serif;color:#e1c99d;margin-bottom:32px}
.kicker{font-size:10px;letter-spacing:4px;color:#d5b87f;font-weight:700}
.name{
 font:700 clamp(48px,8vw,82px)/1.15 "Scheherazade New",Amiri,serif;
 margin:18px 0 20px;color:#fff;
}
.ayah{font:400 clamp(21px,3vw,29px)/2 Amiri,serif;color:#f7eddb;margin:0 auto}
.ayah-source{font-size:11px;color:#d8c3a0;margin:5px 0 25px}
.dua-line{
 display:inline-block;padding:10px 28px;border-top:1px solid #d9bd8866;
 border-bottom:1px solid #d9bd8866;font:400 20px Amiri,serif;color:#e6d4b5
}
.home-menu{
 margin:34px auto 0;border:1px solid #d9bd8870;background:#f9f0df;
 color:var(--espresso);border-radius:13px;padding:13px 34px;font-weight:700;
 box-shadow:0 12px 30px rgba(0,0,0,.20);transition:.18s
}
.home-menu:hover{transform:translateY(-2px)}
.stats{display:flex;justify-content:center;gap:10px;margin-top:24px}
.stat{
 min-width:170px;padding:10px 18px;border:1px solid #d9bd8840;
 background:#fff9ed0e;border-radius:13px
}
.stat-label{font-size:10px;color:#d8c5a7}
.stat-number{font-size:24px;color:#fff;font-weight:700}

/* ================= MENU OVERLAY ================= */
.menu-overlay{
 position:fixed;inset:0;background:rgba(32,20,13,.70);
 backdrop-filter:blur(8px);z-index:200;
 opacity:0;visibility:hidden;transition:.2s;
}
.menu-overlay.open{opacity:1;visibility:visible}
.menu-card{
 position:absolute;right:50%;top:50%;transform:translate(50%,-46%);
 width:min(520px,calc(100% - 30px));max-height:90svh;overflow:auto;
 background:linear-gradient(145deg,#fffaf1,#eee0c7);
 border:1px solid var(--line);border-radius:28px;padding:28px;
 box-shadow:0 30px 90px rgba(0,0,0,.28);
 transition:.25s;
}
.menu-overlay.open .menu-card{transform:translate(50%,-50%)}
.menu-heading{
 display:flex;align-items:center;justify-content:space-between;
 padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid var(--line)
}
.menu-heading h2{font:700 36px/1 "Scheherazade New",Amiri,serif;margin:0;color:var(--brown)}
.close-menu{
 border:1px solid var(--line);background:var(--ivory);color:var(--brown);
 width:40px;height:40px;border-radius:12px;font-size:22px
}
.menu-items{display:grid;gap:10px}
.menu-item{
 width:100%;text-align:right;border:1px solid var(--line);
 background:rgba(255,250,241,.88);border-radius:17px;
 padding:16px 19px;color:var(--espresso);transition:.18s
}
.menu-item:hover{background:#f8edda;border-color:var(--gold-light);transform:translateY(-1px)}
.menu-item strong{display:block;font:700 28px/1.2 "Scheherazade New",Amiri,serif;color:var(--brown)}
.menu-item span{display:block;font-size:11px;color:var(--muted);margin-top:4px}

/* ================= SINGLE-PAGE APP ================= */
.app{display:none;min-height:100svh;background:linear-gradient(135deg,#efe3cf,#f6eddf)}
.app.active{display:block}
.app-header{
 position:sticky;top:0;z-index:100;background:#fffaf1eb;
 backdrop-filter:blur(12px);border-bottom:1px solid var(--line)
}
.app-header-inner{height:66px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{font:700 27px "Scheherazade New",Amiri,serif;color:var(--brown)}
.header-btn{
 border:1px solid var(--line);background:var(--ivory);color:var(--brown);
 border-radius:11px;padding:8px 14px;font-weight:700
}

/* CRITICAL: only the selected view is displayed */
.view{display:none !important}
.view.active{display:block !important}

.section{padding:58px 0 70px}
.section-head{text-align:center;margin-bottom:30px}
.eyebrow{font-size:10px;letter-spacing:3px;color:var(--gold);font-weight:700}
.title{font:700 clamp(42px,7vw,60px)/1.1 "Scheherazade New",Amiri,serif;color:var(--brown);margin:7px 0}
.desc{max-width:720px;margin:auto;color:var(--muted);font-size:13px;line-height:2}
.panel{background:rgba(255,250,241,.88);border:1px solid var(--line);border-radius:27px;box-shadow:var(--shadow)}

/* ================= AZKAR ================= */
.tabs{display:flex;justify-content:center;gap:8px;margin-bottom:18px}
.tab{
 border:1px solid var(--line);background:var(--ivory);color:var(--brown);
 padding:10px 25px;border-radius:12px;font-weight:700
}
.tab.active{background:var(--brown);color:#fff}
.azkar-list{display:grid;gap:14px}
.zekr{padding:21px;border:1px solid var(--line);border-radius:21px;background:var(--ivory)}
.zekr-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.zekr-title{font-size:14px;font-weight:700;color:var(--brown)}
.repeat{font-size:11px;color:var(--brown);background:#f0e2ca;border:1px solid var(--line);padding:5px 10px;border-radius:99px;white-space:nowrap}
.zekr-text{font:400 24px/2.15 Amiri,serif;margin:14px 0;color:#38271c}
.benefit{font-size:11px;line-height:1.9;color:#796854;background:#f4e9d7;border-right:3px solid var(--gold);padding:8px 12px;border-radius:8px}
.zekr-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:13px}
.zekr-count{font-size:11px;color:var(--muted)}
.zekr-btn{border:0;background:var(--brown);color:#fff;border-radius:11px;padding:10px 18px;font-weight:700}
.zekr-btn.done{background:#967b55}
.zekr-source{font-size:10px;color:#9b8976;margin-top:9px}

/* ================= QURAN ================= */
.quran-box{padding:15px;background:#e4d3b5;border:1px solid #d0b98e;border-radius:27px}
.quran-controls{display:grid;grid-template-columns:1fr auto auto;gap:8px}
.select{border:1px solid #d4c09d;background:var(--ivory);color:var(--brown);padding:12px;border-radius:12px;outline:none}
.action{border:0;background:var(--brown);color:#fff;padding:12px 18px;border-radius:12px;font-weight:700}
.action.light{background:var(--ivory);color:var(--brown);border:1px solid var(--line)}
.mushaf{
 margin-top:13px;background:var(--ivory);border:6px double #c6a364;
 border-radius:18px;padding:25px 17px;min-height:380px
}
.surah-title{text-align:center;font:400 31px Amiri,serif;color:var(--brown);padding-bottom:14px;border-bottom:1px solid #decfb5}
.ayah-q{font:400 24px/2.2 Amiri,serif;padding:11px 0;border-bottom:1px solid #eee3d3}
.ayah-q:last-child{border-bottom:0}
.ayah-num{
 display:inline-grid;place-items:center;width:29px;height:29px;
 border:1px solid var(--gold);border-radius:50%;font:400 10px Cairo,sans-serif;
 color:#886a36;margin-left:7px
}
.status{text-align:center;color:var(--muted);font-size:12px;padding:30px 10px}
audio{width:100%;margin-top:10px}

/* ================= TASBEEH ================= */
.tas-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.tas-card{padding:25px;text-align:center}
.tas-name{font:400 25px Amiri,serif;color:var(--brown);min-height:43px}
.tas-num{font-size:29px;font-weight:700;color:var(--brown);margin:5px 0}
.tas-ring{
 width:142px;height:142px;border-radius:50%;margin:14px auto;
 background:radial-gradient(circle,#fffaf1 0 58%,#c5a66d 59% 63%,#6e4b31 64% 100%);
 border:5px solid #b58a4d;display:grid;place-items:center;
 box-shadow:0 14px 30px #5a3a2522;transition:.12s
}
.tas-ring:active{transform:scale(.96)}
.tas-center{
 width:91px;height:91px;border-radius:50%;background:var(--ivory);
 border:1px solid var(--line);display:grid;place-items:center;
 color:var(--brown);font-size:11px;font-weight:700
}
.reset{border:1px solid var(--line);background:transparent;color:var(--brown);border-radius:10px;padding:8px 13px;font-size:11px}

/* ================= RADIO / DUA ================= */
.radio{padding:32px;background:linear-gradient(145deg,#4a2e1e,#795337);color:#fff}
.radio h3,.dua-main h3{font:700 42px/1.2 "Scheherazade New",Amiri,serif;margin:0 0 10px}
.radio p{color:#e9dcc6;line-height:2;font-size:13px}
.dua-main{padding:30px}
.dua-main p{font:400 24px/2.15 Amiri,serif}
.dua-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.dua-card{background:var(--ivory);border:1px solid var(--line);border-radius:18px;padding:19px;font:400 20px/2 Amiri,serif}

@media(max-width:700px){
 .container{width:calc(100% - 22px)}
 .home-inner{padding-top:30px}
 .name{font-size:53px}
 .stats{gap:7px}
 .stat{min-width:0;flex:1}
 .menu-card{padding:22px}
 .menu-heading h2{font-size:32px}
 .section{padding:42px 0 60px}
 .quran-controls{grid-template-columns:1fr}
 .tas-grid{grid-template-columns:1fr}
 .dua-list{grid-template-columns:1fr}
 .zekr-text{font-size:22px}
 .zekr-bottom{flex-direction:column;align-items:stretch}
 .zekr-btn{width:100%}
 .brand{font-size:23px}
}
</style>
</head>
