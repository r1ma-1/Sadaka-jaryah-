const sel=document.getElementById('surahSelect');
surahs.forEach((s,i)=>{const o=document.createElement('option');o.value=i+1;o.textContent=`${i+1}. سورة ${s[0]}`;sel.appendChild(o)});
async function fetchQuranEdition(n, edition){
 const r=await fetch(`https://api.alquran.cloud/v1/surah/${n}/${edition}`, {cache:'no-store'});
 if(!r.ok) throw new Error('API '+r.status);
 const j=await r.json();
 if(!j.data || !j.data.ayahs) throw new Error('No data');
 return j.data;
}
async function loadSurah(){
 const n=Number(sel.value), box=document.getElementById('mushaf');
 box.innerHTML='<div class="quran-status"><span style="font-size:30px"></span><br>جاري فتح المصحف...</div>';
 let d=null;
 try { d=await fetchQuranEdition(n,'quran-uthmani-quran-academy'); }
 catch(e1) {
  try { d=await fetchQuranEdition(n,'quran-uthmani'); }
  catch(e2) {
   box.innerHTML=`<div class="quran-status">
    <div style="font-size:42px;margin-bottom:10px"></div>
    <b style="color:#6f4a2f">المصحف جاهز، لكن تعذر الاتصال بخدمة النص الآن.</b>
    <br><br>
    <a class="action" href="https://alquran.cloud/" target="_blank" rel="noopener">فتح المصحف الكامل</a>
    <p style="margin-top:12px">عند نشر الموقع على GitHub Pages جرّبي تحديث الصفحة، وسيُحمّل النص تلقائيًا.</p>
   </div>`;
   return;
  }
 }
 let out=`<div class="surah-title">سُورَةُ ${d.name.replace('سُورَةُ ','')}</div>`;
 d.ayahs.forEach(a=>{out+=`<div class="ayah-q"><span class="ayah-num">${a.numberInSurah}</span>${a.text}</div>`});
 box.innerHTML=out;
 const audio=document.getElementById('quranAudio');
 const padded=String(n).padStart(3,'0');
 // Full-surah audio: stable Quran Audio Chapters mirror, with MP3Quran fallback.
 audio.src=`https://github.com/The-Quran-Project/Quran-Audio-Chapters/raw/refs/heads/main/Data/${n}/${n}.mp3`;
 audio.dataset.fallback=`https://server8.mp3quran.net/afs/${padded}.mp3`;
 audio.dataset.surah=String(n);
 audio.onerror=()=>{ if(audio.src!==audio.dataset.fallback) audio.src=audio.dataset.fallback; };
}
document.getElementById('loadSurah').onclick=loadSurah;
document.getElementById('playSurah').onclick=async()=>{const audio=document.getElementById('quranAudio'); if(!audio.src || !audio.dataset.surah || audio.dataset.surah!==sel.value){await loadSurah()} audio.play().catch(()=>showToast('اضغط تشغيل من مشغل الصوت'))}
sel.value='1';loadSurah();

/* ---------- UI ---------- */
function showToast(t){const el=document.getElementById('toast');el.textContent=t;el.classList.add('show');clearTimeout(window.tt);window.tt=setTimeout(()=>el.classList.remove('show'),1800)}
const ids=['quran','adhkar','tasbeeh','radio','dua'];
const links=[...document.querySelectorAll('.side-index a'),...document.querySelectorAll('.mobile-index a')];
const observer=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+e.target.id))}})},{rootMargin:'-35% 0px -55% 0px'});
ids.forEach(id=>{const e=document.getElementById(id);if(e)observer.observe(e)});

/* Navigation: exactly one section at a time */
const homeEl=document.getElementById('homeView');
const appEl=document.getElementById('app');
const drawerEl=document.getElementById('drawer');

function openMenu(){drawerEl.classList.add('open');drawerEl.setAttribute('aria-hidden','false')}
function closeMenu(){drawerEl.classList.remove('open');drawerEl.setAttribute('aria-hidden','true')}

function showOnlyView(id){
  homeEl.style.display='none';
  appEl.classList.add('active');
  document.querySelectorAll('.view').forEach(v=>{
    v.classList.remove('active');
    v.style.display='none';
  });
  const target=document.getElementById(id);
  if(target){
    target.classList.add('active');
    target.style.display='block';
  }
  closeMenu();
  window.scrollTo(0,0);
}

document.getElementById('openMenu').onclick=openMenu;
document.getElementById('openMenu2').onclick=openMenu;
document.getElementById('closeMenu').onclick=closeMenu;

drawerEl.addEventListener('click',e=>{
 if(e.target===drawerEl)closeMenu();
});
document.querySelectorAll('.menu-item').forEach(btn=>{
 btn.addEventListener('click',()=>showOnlyView(btn.dataset.view));
});
document.getElementById('backHome').onclick=()=>{
 appEl.classList.remove('active');
 document.querySelectorAll('.view').forEach(v=>{v.classList.remove('active');v.style.display='none'});
 homeEl.style.display='flex';
 window.scrollTo(0,0);
};

