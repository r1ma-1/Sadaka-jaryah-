<script>
/* ---------- Global counters ----------
   CounterAPI: الزوار يوميًّا، والذكر تراكمي عالميًا.
   If it is unavailable, the site falls back to local storage.
*/
const COUNTER_BASE = 'https://api.counterapi.dev/v1/abdelrahim-sadaqa';
const localKeys = {visits:'localVisits', dhikr:'localDhikr'};

function fmt(n){ return Number(n||0).toLocaleString('ar-EG'); }
function todayKey(){
 const d=new Date();
 return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function dailyVisitCounterName(){ return `visits-${todayKey()}`; }

async function counterUp(name){
 try{
   const r=await fetch(`${COUNTER_BASE}/${name}/up`,{cache:'no-store'});
   if(!r.ok) throw new Error('counter');
   const j=await r.json();
   return Number(j?.data ?? j?.count ?? 0);
 }catch(e){
   const k=localKeys[name];
   const n=(Number(localStorage.getItem(k)||0)+1);
   localStorage.setItem(k,n); return n;
 }
}
async function counterGet(name){
 try{
   const r=await fetch(`${COUNTER_BASE}/${name}`,{cache:'no-store'});
   if(!r.ok) throw new Error('counter');
   const j=await r.json();
   return Number(j?.data ?? j?.count ?? 0);
 }catch(e){return Number(localStorage.getItem(localKeys[name])||0);}
}
function setStat(id,n){document.getElementById(id).textContent=fmt(n);}

(async function initCounters(){
 const visitSessionKey = `countedVisit-${todayKey()}`;
 if(!sessionStorage.getItem(visitSessionKey)){
   sessionStorage.setItem(visitSessionKey,'1');
   const n=await counterUp(dailyVisitCounterName()); setStat('visits',n);
 }else setStat('visits',await counterGet(dailyVisitCounterName()));
 setStat('dhikrTotal',await counterGet('dhikr'));
})();

async function registerDhikr(){
 const n=await counterUp('dhikr'); setStat('dhikrTotal',n);
}

/* ---------- Adhkar ---------- */
const azkar = {
 morning:[
  {id:75,t:1,title:'آية الكرسي',text:'اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ.',benefit:'من قالها حين يصبح حُفظ بها حتى يمسي.',source:'حصن المسلم 75 — البقرة 255'},
  {id:76,t:3,title:'الإخلاص والفلق والناس',text:'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ ۝ قُلْ هُوَ اللَّهُ أَحَدٌ ۝ اللَّهُ الصَّمَدُ ۝ لَمْ يَلِدْ وَلَمْ يُولَدْ ۝ وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ. بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ ۝ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ ۝ مِنْ شَرِّ مَا خَلَقَ ۝ وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ ۝ وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ ۝ وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ. بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ ۝ قُلْ أَعُوذُ بِرَبِّ النَّاسِ ۝ مَلِكِ النَّاسِ ۝ إِلَٰهِ النَّاسِ ۝ مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ ۝ الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ ۝ مِنَ الْجِنَّةِ وَالنَّاسِ.',benefit:'تُقال ثلاث مرات صباحًا ومساءً، وهي من أذكار التحصين.',source:'حصن المسلم 76 — الإخلاص والفلق والناس'},
  {id:77,t:1,title:'أصبحنا وأصبح الملك لله',text:'أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، رَبِّ أَسْأَلُكَ خَيْرَ مَا فِي هَذَا الْيَوْمِ وَخَيْرَ مَا بَعْدَهُ، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَذَا الْيَوْمِ وَشَرِّ مَا بَعْدَهُ، رَبِّ أَعُوذُ بِكَ مِنَ الْكَسَلِ وَسُوءِ الْكِبَرِ، رَبِّ أَعُوذُ بِكَ مِنْ عَذَابٍ فِي النَّارِ وَعَذَابٍ فِي الْقَبْرِ.',benefit:'دعاء جامع لخير اليوم والاستعاذة من شره.',source:'حصن المسلم 77'},
  {id:78,t:1,title:'اللهم بك أصبحنا',text:'اللَّهُمَّ بِكَ أَصْبَحْنَا وَبِكَ أَمْسَيْنَا، وَبِكَ نَحْيَا وَبِكَ نَمُوتُ، وَإِلَيْكَ النُّشُورُ.',benefit:'ذكر يربط بداية اليوم بالله وتوحيده والرجوع إليه.',source:'حصن المسلم 78'},
  {id:79,t:1,title:'سيد الاستغفار',text:'اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَى عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ بِذَنْبِي فَاغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ.',benefit:'من قاله موقنًا به ومات في يومه كان من أهل الجنة.',source:'حصن المسلم 79 — البخاري'},
  {id:80,t:4,title:'اللهم إني أصبحت أشهدك',text:'اللَّهُمَّ إِنِّي أَصْبَحْتُ أُشْهِدُكَ، وَأُشْهِدُ حَمَلَةَ عَرْشِكَ، وَمَلَائِكَتَكَ وَجَمِيعَ خَلْقِكَ، أَنَّكَ أَنْتَ اللَّهُ لَا إِلَهَ إِلَّا أَنْتَ وَحْدَكَ لَا شَرِيكَ لَكَ، وَأَنَّ مُحَمَّدًا عَبْدُكَ وَرَسُولُكَ.',benefit:'ورد في فضله أن من قاله أربع مرات أُعتق من النار.',source:'حصن المسلم 80'},
  {id:81,t:1,title:'اللهم ما أصبح بي من نعمة',text:'اللَّهُمَّ مَا أَصْبَحَ بِي مِنْ نِعْمَةٍ أَوْ بِأَحَدٍ مِنْ خَلْقِكَ، فَمِنْكَ وَحْدَكَ لَا شَرِيكَ لَكَ، فَلَكَ الْحَمْدُ وَلَكَ الشُّكْرُ.',benefit:'من أذكار شكر النعمة، وورد أنه أداء لشكر نعمة ذلك اليوم.',source:'حصن المسلم 81'},
  {id:82,t:3,title:'اللهم عافني في بدني',text:'اللَّهُمَّ عَافِنِي فِي بَدَنِي، اللَّهُمَّ عَافِنِي فِي سَمْعِي، اللَّهُمَّ عَافِنِي فِي بَصَرِي، لَا إِلَهَ إِلَّا أَنْتَ. اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكُفْرِ وَالْفَقْرِ، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، لَا إِلَهَ إِلَّا أَنْتَ.',benefit:'سؤال للعافية في البدن والسمع والبصر والاستعاذة من الفقر وعذاب القبر.',source:'حصن المسلم 82'},
  {id:83,t:7,title:'حسبي الله لا إله إلا هو',text:'حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ، عَلَيْهِ تَوَكَّلْتُ، وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ.',benefit:'ورد في فضله قول حصن المسلم: من قاله سبع مرات كفاه الله ما أهمه.',source:'حصن المسلم 83'},
  {id:84,t:1,title:'اللهم إني أسألك العفو والعافية',text:'اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي دِينِي وَدُنْيَايَ وَأَهْلِي وَمَالِي، اللَّهُمَّ اسْتُرْ عَوْرَاتِي وَآمِنْ رَوْعَاتِي، اللَّهُمَّ احْفَظْنِي مِنْ بَيْنِ يَدَيَّ وَمِنْ خَلْفِي وَعَنْ يَمِينِي وَعَنْ شِمَالِي وَمِنْ فَوْقِي، وَأَعُوذُ بِعَظَمَتِكَ أَنْ أُغْتَالَ مِنْ تَحْتِي.',benefit:'دعاء جامع للعفو والعافية والحفظ من الجهات كلها.',source:'حصن المسلم 84'},
  {id:85,t:1,title:'اللهم عالم الغيب والشهادة',text:'اللَّهُمَّ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ، فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ، رَبَّ كُلِّ شَيْءٍ وَمَلِيكَهُ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ، أَعُوذُ بِكَ مِنْ شَرِّ نَفْسِي وَمِنْ شَرِّ الشَّيْطَانِ وَشِرْكِهِ، وَأَنْ أَقْتَرِفَ عَلَى نَفْسِي سُوءًا أَوْ أَجُرَّهُ إِلَى مُسْلِمٍ.',benefit:'استعاذة من شر النفس والشيطان ومن إيذاء المسلم.',source:'حصن المسلم 85'},
  {id:86,t:3,title:'بسم الله الذي لا يضر مع اسمه شيء',text:'بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ.',benefit:'ورد أنه من قاله ثلاثًا صباحًا لم تصبه فجأة بلاء حتى يمسي، ومثله في المساء حتى يصبح.',source:'حصن المسلم 86'},
  {id:87,t:3,title:'رضيت بالله ربًا',text:'رَضِيتُ بِاللَّهِ رَبًّا، وَبِالْإِسْلَامِ دِينًا، وَبِمُحَمَّدٍ نَبِيًّا.',benefit:'ورد في فضله أن من قاله ثلاثًا كان له وعد بالرضا يوم القيامة.',source:'حصن المسلم 87'},
  {id:88,t:1,title:'يا حي يا قيوم برحمتك أستغيث',text:'يَا حَيُّ يَا قَيُّومُ، بِرَحْمَتِكَ أَسْتَغِيثُ، أَصْلِحْ لِي شَأْنِي كُلَّهُ، وَلَا تَكِلْنِي إِلَى نَفْسِي طَرْفَةَ عَيْنٍ.',benefit:'دعاء للاستغاثة بالله وطلب إصلاح جميع الشأن.',source:'حصن المسلم 88'},
  {id:89,t:1,title:'أصبحنا وأصبح الملك لله رب العالمين',text:'أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ رَبِّ الْعَالَمِينَ، اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَ هَذَا الْيَوْمِ: فَتْحَهُ وَنَصْرَهُ وَنُورَهُ وَبَرَكَتَهُ وَهُدَاهُ، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِيهِ وَشَرِّ مَا بَعْدَهُ.',benefit:'سؤال خير اليوم ونصره ونوره وبركته وهداه والاستعاذة من شره.',source:'حصن المسلم 89'},
  {id:90,t:1,title:'أصبحنا على فطرة الإسلام',text:'أَصْبَحْنَا عَلَى فِطْرَةِ الْإِسْلَامِ، وَعَلَى كَلِمَةِ الْإِخْلَاصِ، وَعَلَى دِينِ نَبِيِّنَا مُحَمَّدٍ ﷺ، وَعَلَى مِلَّةِ أَبِينَا إِبْرَاهِيمَ حَنِيفًا مُسْلِمًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ.',benefit:'تجديد لمعاني التوحيد والاتباع والفطرة.',source:'حصن المسلم 90'},
  {id:91,t:100,title:'سبحان الله وبحمده',text:'سُبْحَانَ اللَّهِ وَبِحَمْدِهِ.',benefit:'مائة مرة صباحًا ومساءً؛ وورد أنه لا يسبقه أحد يوم القيامة إلا من زاد عليه.',source:'حصن المسلم 91 — البخاري'},
  {id:92,t:10,title:'لا إله إلا الله وحده لا شريك له',text:'لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ.',benefit:'ورد في فضله كتابة حسنات ومحو سيئات والتحصين من الشيطان عند قوله عشر مرات.',source:'حصن المسلم 92'},
  {id:93,t:100,title:'لا إله إلا الله وحده لا شريك له — 100 مرة',text:'لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ.',benefit:'مائة مرة في اليوم؛ ورد في فضلها أجر عظيم وكتابة حسنات ومحو سيئات والتحصين من الشيطان.',source:'حصن المسلم 93 — البخاري ومسلم'},
  {id:94,t:3,title:'سبحان الله وبحمده عدد خلقه',text:'سُبْحَانَ اللَّهِ وَبِحَمْدِهِ، عَدَدَ خَلْقِهِ، وَرِضَا نَفْسِهِ، وَزِنَةَ عَرْشِهِ، وَمِدَادَ كَلِمَاتِهِ.',benefit:'ثلاث مرات صباحًا؛ ذكر عظيم في معناه وكثرة ما يشتمل عليه من التسبيح.',source:'حصن المسلم 94 — مسلم'},
  {id:95,t:1,title:'اللهم إني أسألك علمًا نافعًا',text:'اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْمًا نَافِعًا، وَرِزْقًا طَيِّبًا، وَعَمَلًا مُتَقَبَّلًا.',benefit:'دعاء جامع للعلم النافع والرزق الطيب والعمل المقبول.',source:'حصن المسلم 95'},
  {id:96,t:100,title:'أستغفر الله وأتوب إليه',text:'أَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ.',benefit:'ورد أن النبي ﷺ كان يستغفر ويتوب إلى الله مائة مرة في اليوم.',source:'حصن المسلم 96 — البخاري ومسلم'},
  {id:98,t:10,title:'اللهم صل وسلم على نبينا محمد ﷺ',text:'اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَى نَبِيِّنَا مُحَمَّدٍ ﷺ.',benefit:'من الصلاة على النبي ﷺ، وقد ورد في فضله نصوص كثيرة.',source:'حصن المسلم 98'}
